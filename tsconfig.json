{
  "compilerOptions": {
    "target": "es2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@angular/*": ["../synapse-ui/node_modules/@angular/*"],
      "rxjs": ["../synapse-ui/node_modules/rxjs"],
      "rxjs/*": ["../synapse-ui/node_modules/rxjs/*"],
      "tslib": ["../synapse-ui/node_modules/tslib"],
      "jest-preset-angular": ["../synapse-ui/node_modules/jest-preset-angular"],
      "jest-preset-angular/*": ["../synapse-ui/node_modules/jest-preset-angular/*"],
    },
    "typeRoots": ["../synapse-ui/node_modules/@types"],
    "types": ["jest"]
  },
  "include": ["components/**/*.ts", "testing/**/*.ts", "index.ts", "test-setup.ts"]
}
