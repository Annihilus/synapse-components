{
  "name": "@synapse/components",
  "version": "0.0.1",
  "description": "Synapse UI components library (consumed as source).",
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./registry.json": "./registry.json"
  },
  "sideEffects": false,
  "peerDependencies": {
    "@angular/common": "^20.1.0",
    "@angular/core": "^20.1.0",
    "@angular/forms": "~20.1.0",
    "@angular/platform-browser": "~20.1.0",
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "snps-cli": "0.1.9"
  },
  "scripts": {
    "test": "../synapse-ui/node_modules/.bin/jest --config jest.config.mjs",
    "test:watch": "../synapse-ui/node_modules/.bin/jest --config jest.config.mjs --watch",
    "typecheck": "../synapse-ui/node_modules/.bin/tsc -p tsconfig.json --noEmit",
    "lint": "../synapse-ui/node_modules/.bin/eslint .",
    "lint:fix": "../synapse-ui/node_modules/.bin/eslint . --fix",
    "test:coverage": "../synapse-ui/node_modules/.bin/jest --config jest.config.mjs --coverage"
